      "default": "queued"
    },
    "status_url": {
      "title": "Status Url",
      "type": "string"
    },
    "events_url": {
      "title": "Events Url",
      "type": "string"
    },
    "result_url": {
      "title": "Result Url",
      "type": "string"
    },
    "queue_position": {
