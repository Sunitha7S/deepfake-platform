      "default": null,
      "title": "Queue Position"
    },
    "estimated_wait_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Wait S"
