  "title": "AnalyzeAcceptedResponse",
  "type": "object",
  "$id": "https://deepfake-platform/schema/1.0.0/AnalyzeAcceptedResponse.json",
  "examples": [
    {
      "job_id": "00000000-0000-0000-0000-000000000006",
      "state": "queued",
      "status_url": "/api/v1/jobs/00000000-0000-0000-0000-000000000006",
      "events_url": "/api/v1/events/00000000-0000-0000-0000-000000000006",
      "result_url": "/api/v1/jobs/00000000-0000-0000-0000-000000000006/result",
