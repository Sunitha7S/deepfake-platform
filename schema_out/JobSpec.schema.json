{
  "$defs": {
    "AnalysisOptions": {
      "additionalProperties": false,
      "description": "Per-request knobs. All optional; defaults are the shipped configuration.",
      "properties": {
        "explain": {
          "default": true,
          "description": "Generate Grad-CAM and spectrum artifacts.",
          "title": "Explain",
          "type": "boolean"
        },
        "max_frames": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 8,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the video frame budget.",
          "title": "Max Frames"
        }
      },
      "title": "AnalysisOptions",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "image",
        "video"
      ],
      "title": "MediaKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What the API hands the queue. Immutable once enqueued.\n\n``idempotency_key`` is ``sha256 + model_version``: the same file analysed by\nthe same model is the same job, so a duplicate enqueue returns the original\nrather than repeating the work.",
  "properties": {
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "media_kind": {
      "$ref": "#/$defs/MediaKind"
    },
    "storage_key": {
      "description": "Object-storage key of the uploaded file.",
      "title": "Storage Key",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 1,
      "title": "Size Bytes",
      "type": "integer"
    },
    "declared_mime": {
      "description": "Client-declared. Never trusted; re-sniffed by the worker.",
      "title": "Declared Mime",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "options": {
      "$ref": "#/$defs/AnalysisOptions"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "principal_id": {
      "default": "anonymous",
      "description": "Future-ready. Today always 'anonymous'; rate limits key on it.",
      "title": "Principal Id",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "media_kind",
    "storage_key",
    "sha256",
    "size_bytes",
    "declared_mime",
    "model_version",
    "idempotency_key",
    "submitted_at"
  ],
  "title": "JobSpec",
  "type": "object",
  "$id": "https://deepfake-platform/schema/1.0.0/JobSpec.json",
  "examples": [
    {
      "job_id": "00000000-0000-0000-0000-000000000006",
      "media_kind": "video",
      "storage_key": "uploads/2026/08/23/u_01J8ZQ4M7X2K9V3P",
      "sha256": "3b1f8c2e9a7d4b6055e1c8f3a2d90b47e6c5148a9f0b3d2e7c614a58d093f2be",
      "size_bytes": 41882004,
      "declared_mime": "video/mp4",
      "model_version": "1.0.0-dev",
      "idempotency_key": "3b1f8c2e9a7d4b6055e1c8f3a2d90b47e6c5148a9f0b3d2e7c614a58d093f2be:1.0.0-dev",
      "options": {
        "explain": true,
        "max_frames": null
      },
      "submitted_at": "2026-08-23T14:30:00Z",
      "principal_id": "anonymous"
    }
  ]
}
